{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yukinal",
  "version": "1.0.0",
  "identifier": "dev.yukinal.workspace",
  "build": {
    "beforeDevCommand": "pnpm --filter @yukinal/agent build && pnpm --filter @yukinal/desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm -w run build:libs && pnpm --filter @yukinal/agent build && pnpm --filter @yukinal/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": true,
        "title": "Yukinal",
        "width": 1440,
        "height": 900,
        "minWidth": 1160,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../agent/dist/index.js": "agent/index.js",
      "resources/agent-package.json": "agent/package.json"
    },
    "category": "DeveloperTool",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0 | libgtk-3-0t64"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    },
    "shortDescription": "AI-native remote development workspace",
    "publisher": "Yukinal contributors",
    "copyright": "MIT licensed"
  }
}

# dependencies
node_modules/
.pnpm-store/
# pnpm is the pinned package manager (package.json "packageManager"); an npm
# lockfile here would be stale and could be picked up by Tooling that prefers it.
package-lock.json

# build output
dist/
build/
out/
# packaging output (scripts/package.mjs: staged payload, checksums, manifest)
target/
apps/desktop/resources/ssh-service/yukinal-ssh-service
apps/desktop/resources/ssh-service/yukinal-ssh-service.exe
apps/desktop/resources/ssh-service/OPENSSL-LICENSE.txt
*.tsbuildinfo
.vite/
coverage/

# env / secrets  (secrets live in the OS credential store, never here)
.env
.env.*
.envrc
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519
secrets/
.secrets/

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# local dev artifacts: dev-server logs and headless-browser screenshots
.devlogs/

# local working notes: design drafts and step plans, never committed
.private/
.yukinal-dev-data/

# local agent worktrees: per-session checkouts, never part of the repository
.claude/

# 2.0 SSH rewrite: Python virtualenv, caches and native build trees
.venv/
agent/.venv/
agent/runtime/*
!agent/runtime/.gitkeep
__pycache__/
*.pyc
native/build/
native/build-*/
build/
agent/*.egg-info/
# control plane: its virtualenv, scratch DBs and editable-install metadata
services/control-plane/.venv/
services/control-plane/.tmp/
services/control-plane/*.egg-info/
services/control-plane/*.db

# local build/scratch logs
build_out.txt
*.buildlog.txt

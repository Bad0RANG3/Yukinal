if(WIN32 AND YUKINAL_USE_BUNDLED_OPENSSL)
  set(OPENSSL_FOUND TRUE)
  set(OpenSSL_FOUND TRUE)
  set(OPENSSL_CRYPTO_FOUND TRUE)
  set(OpenSSL_Crypto_FOUND TRUE)
  set(OPENSSL_VERSION "3.5.9")
  set(OpenSSL_VERSION "3.5.9")
  set(OPENSSL_INCLUDE_DIR "${YUKINAL_OPENSSL_INCLUDE_DIR}")
  set(OPENSSL_CRYPTO_LIBRARY "${YUKINAL_OPENSSL_CRYPTO_LIBRARY}")
  set(OPENSSL_CRYPTO_LIBRARIES "${YUKINAL_OPENSSL_CRYPTO_LIBRARY}")

  if(NOT TARGET OpenSSL::Crypto)
    add_library(OpenSSL::Crypto UNKNOWN IMPORTED GLOBAL)
    set_target_properties(OpenSSL::Crypto PROPERTIES
      IMPORTED_LOCATION "${YUKINAL_OPENSSL_CRYPTO_LIBRARY}"
      INTERFACE_INCLUDE_DIRECTORIES "${YUKINAL_OPENSSL_INCLUDE_DIR}"
      INTERFACE_LINK_LIBRARIES "crypt32;bcrypt;ws2_32;advapi32;user32;gdi32"
    )
  endif()
  return()
endif()

include("${CMAKE_ROOT}/Modules/FindOpenSSL.cmake")

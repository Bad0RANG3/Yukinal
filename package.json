{
  "name": "yukinal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-native Remote Development & Infrastructure Workspace",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "build:libs": "pnpm --filter \"./packages/**\" --if-present build",
    "build:python-agent": "node scripts/build-python-agent.mjs",
    "smoke:python-agent": "node scripts/smoke-python-agent.mjs",
    "test": "pnpm -r --if-present test && node --test scripts/lib/tauri-agent-command.test.mjs",
    "smoke:sidecar": "node scripts/smoke-sidecar.mjs",
    "package": "node scripts/package.mjs",
    "release:manifest": "node scripts/write-release-manifest.mjs",
    "desktop:dev": "pnpm --filter @yukinal/desktop dev",
    "desktop:dev:python": "node scripts/dev-python-agent.mjs",
    "agent:dev": "pnpm --filter @yukinal/agent dev",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
